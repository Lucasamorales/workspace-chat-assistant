# Buddy deployment settings. No secrets in this file — secrets live in Secret Manager.
PROJECT_ID=your-gcp-project
REGION=europe-west1

BOT_SERVICE=buddy-bot
OAUTH_SERVICE=buddy-oauth
BOT_SA=buddy-bot
OAUTH_SA=buddy-oauth
BUILD_SA=buddy-build
AR_REPO=buddy
KMS_KEYRING=buddy
KMS_KEY=tokens

# Secret Manager secret names
SECRET_ANTHROPIC=anthropic-key
SECRET_STATE=buddy-state-secret
SECRET_ASANA=asana-mcp-client-secret
# Experiment 0010 only: the secret buddy-bot and the subscription proxy share.
SECRET_PROXY=claude-proxy-secret

# Experiment (docs/decisions/0010-subscription-proxy.md, develop branch only). These people are
# answered by the subscription proxy on the PC where Claude Code is logged in, instead of the API.
# Empty = nobody, and the service behaves exactly as without the experiment. No fallback: if the
# proxy can't answer, their message fails and says why.
CLAUDE_PROXY_USERS=remy@example.com,robin@example.com,alexandra@example.com,jordan@example.com,riley@example.com

# The tunnel's https URL, with no path and no trailing slash, e.g. https://buddy-proxy.example.com
CLAUDE_PROXY_URL=https://buddy-proxy.34studio.co.uk

# Who may talk to Buddy at all (also restrict visibility in the Chat app console).
# Entries: emails, users/<chat id>, or domain:example.com
ALLOWED_USERS=robin@example.com,remy@example.com,alexandra@example.com,jordan@example.com,riley@example.com

# Who may use each module. Required for every module in MODULES; same entry syntax.
# Any variable starting with BUDDY_ACCESS_ or BUDDY_ROLE_ is passed to buddy-bot by deploy.sh.
# Admin can grant other people access to modules from a DM, so keep this list tiny. It is the
# one permission Buddy can never change: admin, leave and assistant stay in this file only.
BUDDY_ACCESS_ADMIN=robin@example.com,remy@example.com

# What Buddy costs, per person and module. Admin-only on purpose: costs are a management
# matter, not a leaderboard (docs/decisions/0006-costs.md).
BUDDY_ACCESS_COSTS=robin@example.com,remy@example.com
COSTS_SHEET_ID=YOUR_COSTS_SHEET_ID
COSTS_TIMEZONE=America/Argentina/Buenos_Aires
BUDDY_ACCESS_BASICS=domain:example.com

# Files: not tested yet, so pilot only. Widen to domain:example.com once it is.
BUDDY_ACCESS_FILES=robin@example.com,remy@example.com,riley@example.com

# Who can chat freely with Claude about anything (the expensive, open-ended one). Asana does NOT
# need this any more: it drives Claude for itself alone (docs/decisions/0007-scoped-conversation.md).
BUDDY_ACCESS_ASSISTANT=robin@example.com,remy@example.com,riley@example.com
BUDDY_ACCESS_ASANA=robin@example.com,remy@example.com,alexandra@example.com,jordan@example.com,riley@example.com

# Kudos: pilot with Robin and Remy until the merge; then domain:example.com
BUDDY_ACCESS_KUDOS=robin@example.com,remy@example.com,riley@example.com
BUDDY_ROLE_KUDOS_ADMIN=robin@example.com,remy@example.com,riley@example.com

# OOO is read-only, so it is open to everyone. Add "ooo" to MODULES once buddy-bot can read
# the calendar below (see docs/BACKLOG.md O0); until then /ooo would only explain it cannot.
BUDDY_ACCESS_OOO=domain:example.com
OOO_CALENDAR_ID=accounts@example.com
# Workspace won't let an outside address see event details, only free/busy, so ooo reads the
# calendar by acting as this one account. Settings only, never a user: see docs/decisions/0003.
# Unset it the day the calendar can be shared with buddy-bot directly.
OOO_READ_AS=accounts@example.com
OOO_TIMEZONE=America/Argentina/Buenos_Aires
# The manual is for everybody; rebuilding the index is admin-only. Anything indexed can be
# quoted to anyone with access, so only put staff-wide material in the folder below.
BUDDY_ACCESS_MANUAL=domain:example.com
BUDDY_ROLE_MANUAL_ADMIN=robin@example.com,remy@example.com,riley@example.com
# Team member manual folder in Drive, shared as Viewer with buddy-bot.
MANUAL_FOLDER_ID=YOUR_MANUAL_FOLDER_ID
MANUAL_PROJECT_ID=your-gcp-project
MANUAL_REGION=europe-west1
# Leave records the whole team's out-of-office, so in the end only the accounts team gets it.
# Pilot with Robin and Remy while it is tested, then swap both lists for the accounts people.
BUDDY_ACCESS_LEAVE=robin@example.com,remy@example.com
# Booking for OTHER people needs this role: accounts staff need it, nobody else should have it,
# because it is the only way past "your own calendar only".
BUDDY_ROLE_LEAVE_ADMIN=robin@example.com,remy@example.com
LEAVE_TEAM_EMAIL=wholeteam@example.com
LEAVE_DEFAULT_SHIFT=ARG_8_5

# Invoices (modules/invoices): reminds people when a bill is ready to download, with a link to it.
# Bills themselves are added in chat by an invoices admin (/invoices add), not here.
BUDDY_ACCESS_INVOICES=robin@example.com
# Who may add, change or remove bills.
BUDDY_ROLE_INVOICES_ADMIN=robin@example.com
# Optional: the Drive folder people save bills into, offered as a link. Buddy never reads it.
INVOICES_FOLDER_ID=1UaRlFoSIiRoanmiq_FDHnBMPqCycf6t9
INVOICES_TIMEZONE=America/Argentina/Buenos_Aires
# The account Cloud Scheduler signs /tasks as; infra/scheduler.sh creates it and prints the email.
# Empty = no scheduled messages at all (/tasks doesn't exist).
BUDDY_SCHEDULER_EMAIL=

# Kudos module settings (every KUDOS_* variable is passed to buddy-bot)
# TEST COPY of the Kudos Sheet. Switch to the real Sheet only at cutover.
KUDOS_SHEET_ID=YOUR_KUDOS_SHEET_ID
# Space ids where votes count, comma-separated. Get an id with "@Buddy /kudos check" in the space.
# spaces/AAAAAAAAAAA = "Buddy testing ground" (test space). Replace with Team - Kudos at cutover.
KUDOS_SPACES=spaces/AAAAAAAAAAA
KUDOS_LEADERSHIP=charlie@example.com,remy@example.com,riley@example.com,toni@example.com,remy.lee@example.com
KUDOS_TIMEZONE=America/Argentina/Buenos_Aires

# Name shown in messages; must match the Chat app name in the console
APP_NAME=Buddy-Asana

MODULES=basics,files,asana,kudos,assistant,ooo,leave,admin,manual,costs,invoices
# The default: everyone with the assistant (and so every admin) runs on this. Opus since 2026-09-28.
MODEL=claude-opus-5-5
EFFORT=medium
# Cost controls (docs/decisions/0009-cost-reduction.md). History is re-sent on every request, so
# its size matters more than its length.
#
# MAX_OUTPUT_TOKENS is a ceiling, not a budget: you pay for the tokens written, never for the
# headroom. Lowering it saves nothing on ordinary replies and truncates the rare long one — at
# 4,000 a 54-task batch update could not be written at all, and every retry was cut at the same
# place. It is insurance against a runaway answer (16,000 tokens ≈ 16¢), not a saving.
MAX_OUTPUT_TOKENS=16000
MAX_HISTORY_CHARS=8000
# 1h keeps the tools and system prompt cached across a burst of questions; 5m is Anthropic's default.
CACHE_TTL=1h
MONTHLY_USD_CAP=15
# The allowance for people who can only drive one module through Claude (e.g. Asana-only).
MONTHLY_USD_CAP_SCOPED=5
# Prices for any model not in MODEL_PRICES — the default model's, so an unknown one looks expensive.
USD_PER_MTOK_IN=4
USD_PER_MTOK_OUT=20
# module:model:effort — for people scoped to modules (no assistant). Someone with several gets the
# strongest model any of them needs, at that module's effort; a module with no entry counts as the
# default (MODEL / EFFORT above). People with the assistant always get the default.
# Asana users without the assistant run on Sonnet 5; the default above is Opus.
MODULE_TUNING=manual:claude-haiku-4-5:low,asana:claude-sonnet-5:medium
# model:inPerMTok:outPerMTok — so /costs prices each model properly. A model with no entry is
# priced at USD_PER_MTOK_IN/OUT: an unknown model must look expensive, never free.
MODEL_PRICES=claude-haiku-4-5:1:5,claude-sonnet-5:2:10,claude-opus-5-5:4:20
# Drop the oldest tool results once a request passes ~30k input tokens, keeping this many recent
# ones. Only matters for long Asana loops. 0 is off — turn it on once the eval has been run
# against it, since it changes what Claude can still see mid-request.
CLEAR_TOOL_USES=0

# From the Asana developer console → your "MCP app" (not a regular OAuth app). Not secret.
ASANA_CLIENT_ID=0000000000000000
# Asana's MCP server offers 39 tools and every definition is re-sent on every request — roughly
# 17,500 tokens before anyone types a word. Only the everyday ones are loaded; the rest are
# deferred and looked up when needed (docs/decisions/0008-tool-payload.md).
#
# Empty uses the built-in match, which loads 13 of 39 — checked against the real list, so an
# empty setting is the right default: it keeps up if Asana adds tools. Name them here only
# to pin the list deliberately, e.g. to load one more.
#
# Loaded: get_task(s), get_my_tasks, search_tasks, search_objects, get_project(s), get_user(s),
# get_me, create_tasks, update_tasks, add_comment. Everything else is looked up when needed —
# including Asana's own preview/confirm tools, which would put a second approval step in front
# of Buddy's card.
ASANA_TOOLS=
